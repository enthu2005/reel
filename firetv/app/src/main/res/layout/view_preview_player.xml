<?xml version="1.0" encoding="utf-8"?>
<!-- The title page's video layer. A texture view (not the default surface view) so a preview handed over from the
     Home screen keeps playing smoothly while the page fades and animates over it. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:shutter_background_color="#00000000" />
